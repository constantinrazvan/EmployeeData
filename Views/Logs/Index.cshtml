@model PagedResult<EmployeeData.Models.AuditLog>
@using EmployeeData.Helpers

@{
    ViewData["Title"] = "Activity Log";
    var actionTypes = ViewBag.ActionTypes as List<string> ?? new List<string>();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5">
    <div>
        <h3 class="fw-bold text-dark mb-1">Audit Register & Logging</h3>
        <p class="text-muted small m-0">Monitor system security and trace all user actions.</p>
    </div>
</div>

<!-- Filters Panel -->
<div class="card shadow-sm border-0 p-4 mb-4 bg-white text-dark">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-6">
            <label class="form-label text-muted small fw-medium">Search log (User, Action, Details)</label>
            <input type="text" name="searchTerm" class="form-control" value="@ViewBag.CurrentSearch" placeholder="Keywords..." />
        </div>
        <div class="col-md-4">
            <label class="form-label text-muted small fw-medium">Filter by Action Type</label>
            <select name="actionFilter" class="form-select">
                <option value="">All Actions</option>
                @foreach (var type in actionTypes)
                {
                    if (ViewBag.CurrentAction == type)
                    {
                        <option value="@type" selected>@type</option>
                    }
                    else
                    {
                        <option value="@type">@type</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary py-2 px-3 rounded-3 flex-fill fw-semibold">
                Filter
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary py-2 px-3 rounded-3 d-flex align-items-center justify-content-center" title="Reset Filters">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                </svg>
            </a>
        </div>
    </form>
</div>

<!-- Logs Timeline Table -->
<div class="card shadow-sm border-0 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle m-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 180px;">Timestamp</th>
                    <th style="width: 140px;">User</th>
                    <th style="width: 180px;">Action Type</th>
                    <th>Action Details</th>
                    <th style="width: 140px;" class="text-end">IP Address</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-25 mb-3">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="8" y1="12" x2="16" y2="12"></line>
                            </svg>
                            <p class="m-0">No log entries found matching the filters.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var log in Model.Items)
                    {
                        string badgeClass = "bg-secondary-subtle text-secondary border border-secondary-subtle"; // Default
                        
                        if (log.Action == "Login" || log.Action == "Logout")
                        {
                            badgeClass = "bg-warning-subtle text-warning border border-warning-subtle";
                        }
                        else if (log.Action == "Login Failure" || log.Action == "Delete Employee" || log.Action == "Revoke Access")
                        {
                            badgeClass = "bg-danger-subtle text-danger border border-danger-subtle";
                        }
                        else if (log.Action == "View" || log.Action == "Search")
                        {
                            badgeClass = "bg-info-subtle text-info border border-info-subtle";
                        }
                        else if (log.Action == "Add Employee" || log.Action == "Create Department" || log.Action == "Grant Access")
                        {
                            badgeClass = "bg-success-subtle text-success border border-success-subtle";
                        }
                        else if (log.Action == "Edit Employee" || log.Action == "Edit Department" || log.Action == "Update Settings" || log.Action == "Database Migrations")
                        {
                            badgeClass = "bg-warning-subtle text-warning border border-warning-subtle";
                        }

                        <tr>
                            <td class="font-monospace text-muted small">
                                @log.Timestamp.ToString("dd.MM.yyyy HH:mm:ss")
                            </td>
                            <td>
                                <span class="fw-bold text-dark">@@@log.Username</span>
                            </td>
                            <td>
                                <span class="badge @badgeClass rounded-pill px-2.5 py-1.5 fw-semibold d-inline-block text-center font-monospace" style="min-width: 120px; font-size: 11px;">
                                    @log.Action
                                </span>
                            </td>
                            <td>
                                <span class="text-dark small text-wrap">@log.Details</span>
                            </td>
                            <td class="text-end font-monospace text-muted small">
                                @log.IpAddress
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination Section -->
<nav aria-label="Pagination" class="d-flex justify-content-between align-items-center mt-4">
    <div class="small text-muted">
        Showing @Model.StartIndex to @Model.EndIndex of @Model.TotalCount log entries
    </div>
    <ul class="pagination mb-0">
        @if (Model.HasPreviousPage)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" 
                   asp-route-pageNumber="1"
                   asp-route-searchTerm="@ViewBag.CurrentSearch"
                   asp-route-actionFilter="@ViewBag.CurrentAction"
                   title="First Page">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                        <polyline points="9 18 3 12 9 6"></polyline>
                    </svg>
                </a>
            </li>
            <li class="page-item">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                   asp-route-searchTerm="@ViewBag.CurrentSearch"
                   asp-route-actionFilter="@ViewBag.CurrentAction">
                    Previous
                </a>
            </li>
        }

        @{
            int startPage = Math.Max(1, Model.PageNumber - 2);
            int endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
        }

        @if (startPage > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="1"
                   asp-route-searchTerm="@ViewBag.CurrentSearch"
                   asp-route-actionFilter="@ViewBag.CurrentAction">
                    1
                </a>
            </li>
            @if (startPage > 2)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }
        }

        @for (int i = startPage; i <= endPage; i++)
        {
            @if (i == Model.PageNumber)
            {
                <li class="page-item active"><span class="page-link">@i</span></li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index"
                       asp-route-pageNumber="@i"
                       asp-route-searchTerm="@ViewBag.CurrentSearch"
                       asp-route-actionFilter="@ViewBag.CurrentAction">
                        @i
                    </a>
                </li>
            }
        }

        @if (endPage < Model.TotalPages)
        {
            @if (endPage < Model.TotalPages - 1)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }
            <li class="page-item">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@Model.TotalPages"
                   asp-route-searchTerm="@ViewBag.CurrentSearch"
                   asp-route-actionFilter="@ViewBag.CurrentAction">
                    @Model.TotalPages
                </a>
            </li>
        }

        @if (Model.HasNextPage)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                   asp-route-searchTerm="@ViewBag.CurrentSearch"
                   asp-route-actionFilter="@ViewBag.CurrentAction">
                    Next
                </a>
            </li>
            <li class="page-item">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@Model.TotalPages"
                   asp-route-searchTerm="@ViewBag.CurrentSearch"
                   asp-route-actionFilter="@ViewBag.CurrentAction"
                   title="Last Page">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                        <polyline points="15 18 21 12 15 6"></polyline>
                    </svg>
                </a>
            </li>
        }
    </ul>
</nav>
