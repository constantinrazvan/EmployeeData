@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var username = HttpContextAccessor.HttpContext?.Session.GetString("Username");
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName");
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("Role");
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ORGPORTAL</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(!string.IsNullOrEmpty(username) ? "has-sidebar" : "")">

@if (!string.IsNullOrEmpty(username))
{
    <!-- ===== FIXED SIDEBAR ===== -->
    <aside class="app-sidebar" id="appSidebar">
        <!-- Logo -->
        <div class="sidebar-logo">
            <a asp-controller="Dashboard" asp-action="Index" class="sidebar-logo-link border-1 border-white">
                <span class="sidebar-logo-text">ORG<span class="sidebar-logo-accent">PORTAL</span></span>
            </a>
        </div>

        <!-- Navigation -->
        <nav class="sidebar-nav">
            <div class="sidebar-nav-label">Main</div>

            <a asp-controller="Dashboard" asp-action="Index"
               class="sidebar-nav-item @(currentController == "Dashboard" ? "active" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect>
                    <rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect>
                </svg>
                <span>Dashboard</span>
            </a>

            <a asp-controller="Employees" asp-action="Index"
               class="sidebar-nav-item @(currentController == "Employees" ? "active" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                <span>Employees</span>
            </a>

            <a asp-controller="Departments" asp-action="Index"
               class="sidebar-nav-item @(currentController == "Departments" ? "active" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
                <span>Departments</span>
            </a>

            <a asp-controller="Reports" asp-action="Index"
               class="sidebar-nav-item @(currentController == "Reports" ? "active" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                </svg>
                <span>Reports</span>
            </a>

            @if (userRole == "Administrator")
            {
                <div class="sidebar-nav-label mt-3">Administration</div>

                <a asp-controller="Roles" asp-action="Index"
                   class="sidebar-nav-item @(currentController == "Roles" ? "active" : "")">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <span>Role Management</span>
                </a>

                <a asp-controller="Logs" asp-action="Index"
                   class="sidebar-nav-item @(currentController == "Logs" ? "active" : "")">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                    <span>Activity Log</span>
                </a>

                <a asp-controller="Settings" asp-action="Index"
                   class="sidebar-nav-item @(currentController == "Settings" ? "active" : "")">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                    </svg>
                    <span>Settings</span>
                </a>
            }
        </nav>

    </aside>

    <!-- ===== TOP HEADER BAR (inside content area) ===== -->
    <div class="app-content">
        <header class="app-topbar">
            <div class="topbar-left">
                <!-- Mobile menu toggle -->
                <button class="topbar-mobile-toggle d-md-none" id="sidebarToggle" onclick="toggleSidebar()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
                <div class="topbar-page-title">@ViewData["Title"]</div>
            </div>
            <div class="topbar-right">
                <!-- Notifications -->
                <div class="dropdown">
                    <button class="topbar-icon-btn position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false" onclick="loadNotifications()">

                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        <span class="topbar-badge d-none" id="notifBadge"></span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow border-0 p-0" style="width:320px;max-height:400px;overflow-y:auto;" id="notifMenu">
                        <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold m-0 text-dark">Notifications</h6>
                        </div>
                        <div id="notifItems">
                            <div class="text-center text-muted py-4 small">Loading...</div>
                        </div>
                    </div>
                </div>
                <!-- User Avatar -->
                <div class="dropdown">
                    <button class="topbar-user-avatar" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@fullName">
                        @(fullName?.Length > 0 ? fullName[0].ToString().ToUpper() : "?")
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow border-0 p-2" style="min-width:180px;">
                        <div class="px-2 py-1 mb-1">
                            <div class="fw-semibold text-dark" style="font-size:13px;">@fullName</div>
                            <div class="text-muted" style="font-size:11px;">@userRole</div>
                        </div>
                        <div class="dropdown-divider my-1"></div>
                        <a asp-controller="Account" asp-action="Logout" class="dropdown-item text-danger d-flex align-items-center gap-2" style="font-size:13px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            Logout
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- ===== MAIN CONTENT ===== -->
        <main class="app-main">
            @RenderBody()
        </main>

        <footer class="app-footer">
            &copy; 2026 <strong>ORGPORTAL</strong> &mdash; Secure Internal Management System
        </footer>
    </div>

    <!-- Mobile overlay -->
    <div class="sidebar-overlay d-none" id="sidebarOverlay" onclick="toggleSidebar()"></div>
}
else
{
    <div class="container mt-4">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    function toggleSidebar() {
        const sidebar = document.getElementById('appSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        sidebar.classList.toggle('sidebar-open');
        overlay.classList.toggle('d-none');
    }

    function loadNotifications() {
        fetch('/Notifications/GetBadge')
            .then(r => r.json())
            .then(data => {
                const badge = document.getElementById('notifBadge');
                const items = document.getElementById('notifItems');

                if (data.count > 0) {
                    badge.textContent = data.count > 9 ? '9+' : data.count;
                    badge.classList.remove('d-none');
                } else {
                    badge.classList.add('d-none');
                }

                if (data.items && data.items.length > 0) {
                    const colorMap = { warning: '#f59e0b', info: '#06b6d4', danger: '#ef4444', success: '#10b981' };
                    const iconMap = {
                        calendar: '<path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/>',
                        clipboard: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
                        alert: '<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
                        'user-plus': '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/>'
                    };
                    items.innerHTML = data.items.map(n => `
                        <a href="${n.link}" class="d-flex align-items-start gap-3 p-3 text-decoration-none border-bottom" style="color:inherit;">
                            <div style="width:32px;height:32px;border-radius:50%;background:${colorMap[n.color] || '#6366f1'}20;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="${colorMap[n.color] || '#6366f1'}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${iconMap[n.icon] || ''}</svg>
                            </div>
                            <div class="small text-dark">${n.message}</div>
                        </a>`).join('');
                } else {
                    items.innerHTML = '<div class="text-center text-muted py-4 small">No new notifications</div>';
                }
            })
            .catch(() => {
                document.getElementById('notifItems').innerHTML = '<div class="text-center text-muted py-3 small">Could not load notifications</div>';
            });
    }

    document.addEventListener('DOMContentLoaded', function() {
        loadNotifications();
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
