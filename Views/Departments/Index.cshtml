@model PagedResult<EmployeeData.Models.Department>
@using EmployeeData.Helpers

@{
    ViewData["Title"] = "Departments";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5">
    <div>
        <h3 class="fw-bold text-dark mb-1">Department Structure</h3>
        <p class="text-muted small m-0">View organizational structure, department managers, and staff allocation.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary py-2 px-4 rounded-3 d-flex align-items-center gap-2 fw-semibold">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add Department
        </a>
    </div>
</div>

<!-- Department Table -->
<div class="card shadow-sm border-0 mb-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 bg-white">
            <thead class="bg-light">
                <tr>
                    <th class="text-muted fw-bold py-3 px-4 border-bottom-0 text-uppercase" style="width: 10%; font-size: 0.85rem; letter-spacing: 0.5px;">Code</th>
                    <th class="text-muted fw-bold py-3 px-4 border-bottom-0 text-uppercase" style="width: 35%; font-size: 0.85rem; letter-spacing: 0.5px;">Department</th>
                    <th class="text-muted fw-bold py-3 px-4 border-bottom-0 text-uppercase" style="width: 25%; font-size: 0.85rem; letter-spacing: 0.5px;">Manager</th>
                    <th class="text-muted fw-bold py-3 px-4 border-bottom-0 text-uppercase text-center" style="width: 15%; font-size: 0.85rem; letter-spacing: 0.5px;">Status</th>
                    <th class="text-muted fw-bold py-3 px-4 border-bottom-0 text-uppercase text-end" style="width: 15%; font-size: 0.85rem; letter-spacing: 0.5px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr class="border-bottom">
                        <td class="px-4 py-3">
                            <span class="badge bg-light text-dark border px-2.5 py-1.5 font-monospace fw-bold rounded-2">@item.Code</span>
                        </td>
                        <td class="px-4 py-3">
                            <div class="d-flex flex-column">
                                <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-dark text-decoration-none hover-primary-link mb-1 fs-6">@item.Name</a>
                                <span class="text-muted small text-truncate" style="max-width: 350px;" title="@item.Description">@item.Description</span>
                            </div>
                        </td>
                        <td class="px-4 py-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 36px; height: 36px; font-size: 0.85rem;">
                                    @{
                                        var initials = string.Join("", item.ManagerName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries).Select(n => n[0]).Take(2));
                                        @initials
                                    }
                                </div>
                                <span class="fw-medium text-dark">@item.ManagerName</span>
                            </div>
                        </td>
                        <td class="px-4 py-3 text-center">
                            <div class="d-inline-flex align-items-center gap-1.5 px-3 py-1.5 rounded-pill bg-light text-primary small fw-semibold border border-primary-subtle">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                </svg>
                                @item.Employees.Count(e => e.Status == "Active") Active
                            </div>
                        </td>
                        <td class="px-4 py-3 text-end">
                            <div class="d-flex gap-2 justify-content-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary d-flex align-items-center justify-content-center rounded-3 p-2 transition-all" title="View Employees">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                    </svg>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center rounded-3 p-2 transition-all" title="Edit Department Details">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                        <path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                    </svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination Section -->
<nav aria-label="Pagination" class="d-flex justify-content-between align-items-center mt-4">
    <div class="small text-muted">
        Showing @Model.StartIndex to @Model.EndIndex of @Model.TotalCount departments
    </div>
    <ul class="pagination mb-0">
        @if (Model.HasPreviousPage)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" 
                   asp-route-pageNumber="1"
                   title="First Page">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                        <polyline points="9 18 3 12 9 6"></polyline>
                    </svg>
                </a>
            </li>
            <li class="page-item">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber - 1)">
                    Previous
                </a>
            </li>
        }

        @{
            int startPage = Math.Max(1, Model.PageNumber - 2);
            int endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
        }

        @if (startPage > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="1">
                    1
                </a>
            </li>
            @if (startPage > 2)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }
        }

        @for (int i = startPage; i <= endPage; i++)
        {
            @if (i == Model.PageNumber)
            {
                <li class="page-item active"><span class="page-link">@i</span></li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index"
                       asp-route-pageNumber="@i">
                        @i
                    </a>
                </li>
            }
        }

        @if (endPage < Model.TotalPages)
        {
            @if (endPage < Model.TotalPages - 1)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }
            <li class="page-item">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@Model.TotalPages">
                    @Model.TotalPages
                </a>
            </li>
        }

        @if (Model.HasNextPage)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber + 1)">
                    Next
                </a>
            </li>
            <li class="page-item">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@Model.TotalPages"
                   title="Last Page">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                        <polyline points="15 18 21 12 15 6"></polyline>
                    </svg>
                </a>
            </li>
        }
    </ul>
</nav>
