@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="login-page d-flex justify-content-center align-items-center min-vh-100">
    <div class="mx-auto" style="width: 100%; max-width: 420px;">

        <!-- Card -->
        <div class="card border-0 p-4" style="border-radius:14px;">
            <h5 class="fw-bold text-dark mb-1">Sign in</h5>
            <p class="text-muted small mb-4">Enter your credentials to access the portal.</p>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger border-0 py-2 px-3 mb-3 small rounded-3">
                        @Html.ValidationSummary(true, "", new { @class = "m-0" })
                    </div>
                }

                <div class="mb-3">
                    <label for="username" class="form-label small fw-semibold text-muted">Username</label>
                    <input type="text" class="form-control" id="username" name="username"
                           required autocomplete="off" placeholder="Enter username" />
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label small fw-semibold text-muted">Password</label>
                    <input type="password" class="form-control" id="password" name="password"
                           required placeholder="Enter password" />
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-semibold py-2">
                    Sign In
                </button>
            </form>
        </div>

        <p class="text-center mt-4 small" style="color:rgba(255,255,255,0.3);">
            &copy; 2026 ORGPORTAL
        </p>
    </div>
</div>