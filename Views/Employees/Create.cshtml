@model EmployeeData.Models.Person

@{
    ViewData["Title"] = "Register Employee";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <!-- Back Button -->
        <div class="mb-4">
            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm py-2 px-3 rounded-3 d-inline-flex align-items-center gap-2 fw-medium">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Back
            </a>
        </div>

        <div class="card shadow-sm border-0 p-5 bg-white text-dark rounded-3">
            <div class="mb-4 border-bottom pb-3">
                <h3 class="fw-bold m-0 text-dark">Add New Employee</h3>
                <p class="text-muted small m-0 mt-1">Fill in the details below to register the person within the organization.</p>
            </div>

            <form asp-action="Create" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                <div class="row g-4">
                    <!-- Profile Photo Upload -->
                    <div class="col-12 border-bottom pb-2">
                        <h5 class="fw-bold text-dark mb-1">Profile Photo</h5>
                        <p class="text-muted small m-0">Upload a custom profile photo (JPEG, PNG). Fallback is a beautifully styled initials circle.</p>
                    </div>
                    <div class="col-12 mb-2">
                        <div class="d-flex align-items-center gap-4 bg-light p-3 rounded-3 border">
                            <div class="avatar-preview-container position-relative flex-shrink-0">
                                <div id="avatarPreview" class="d-flex align-items-center justify-content-center text-white fw-bold rounded-circle border border-3 border-white shadow-sm" style="width: 80px; height: 80px; font-size: 1.8rem; background-color: #6366f1; transition: all 0.2s ease;">
                                    ?
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <label for="Photo" class="form-label text-muted small fw-medium mb-1">Select Photo</label>
                                <input type="file" id="Photo" name="Photo" class="form-control form-control-sm" accept="image/*" />
                                <div class="form-text text-muted" style="font-size: 11px;">Max size 2MB. Square images work best. Live preview updates automatically.</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label text-muted small fw-medium">First Name</label>
                        <input asp-for="FirstName" class="form-control" placeholder="e.g., John" required />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label text-muted small fw-medium">Last Name</label>
                        <input asp-for="LastName" class="form-control" placeholder="e.g., Doe" required />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label text-muted small fw-medium">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="john.doe@organization.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label text-muted small fw-medium">Phone Number</label>
                        <input asp-for="Phone" class="form-control" placeholder="e.g., 0722111222" required />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Position" class="form-label text-muted small fw-medium">Position / Role</label>
                        <input asp-for="Position" class="form-control" placeholder="e.g., Software Developer" required />
                        <span asp-validation-for="Position" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DepartmentId" class="form-label text-muted small fw-medium">Assigned Department</label>
                        <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.DepartmentId" required></select>
                        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="BirthDate" class="form-label text-muted small fw-medium">Date of Birth</label>
                        <input asp-for="BirthDate" type="date" class="form-control" />
                        <span asp-validation-for="BirthDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HireDate" class="form-label text-muted small fw-medium">Hire Date</label>
                        <input asp-for="HireDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        <span asp-validation-for="HireDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ContractPeriod" class="form-label text-muted small fw-medium">Contract Type</label>
                        <select asp-for="ContractPeriod" class="form-select" asp-items="Html.GetEnumSelectList<EmployeeData.Models.Enums.ContractPeriod>()" required></select>
                        <span asp-validation-for="ContractPeriod" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label text-muted small fw-medium">Initial Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TerminationDate" class="form-label text-muted small fw-medium">Termination Date (Optional)</label>
                        <input asp-for="TerminationDate" type="date" class="form-control" />
                        <span asp-validation-for="TerminationDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-5 d-flex gap-3 justify-content-end">
                    <a href="javascript:history.back()" class="btn btn-outline-secondary px-4 py-2.5 rounded-3 fw-semibold">Cancel</a>
                    <button type="submit" class="btn btn-primary px-5 py-2.5 rounded-3 fw-semibold">Register Employee</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const contractSelect = document.getElementById("ContractPeriod");
            const hireDateInput = document.getElementById("HireDate");
            const terminationInput = document.getElementById("TerminationDate");

            // Live Preview Elements
            const firstNameInput = document.getElementById("FirstName");
            const lastNameInput = document.getElementById("LastName");
            const avatarPreview = document.getElementById("avatarPreview");
            const photoInput = document.getElementById("Photo");

            function updateInitialsPreview() {
                if (photoInput.files && photoInput.files[0]) {
                    return; // Don't overwrite image preview with initials
                }
                const first = firstNameInput.value.trim().charAt(0).toUpperCase();
                const last = lastNameInput.value.trim().charAt(0).toUpperCase();
                const initials = (first || "") + (last || "") || "?";
                avatarPreview.textContent = initials;
                
                const fullName = (firstNameInput.value.trim() + " " + lastNameInput.value.trim()).trim();
                if (fullName) {
                    const colors = ["#6366f1", "#8b5cf6", "#06b6d4", "#10b981", "#f59e0b", "#ef4444", "#ec4899"];
                    let hash = 0;
                    for (let i = 0; i < fullName.length; i++) {
                        hash = fullName.charCodeAt(i) + ((hash << 5) - hash);
                    }
                    const color = colors[Math.abs(hash) % colors.length];
                    avatarPreview.style.backgroundColor = color;
                } else {
                    avatarPreview.style.backgroundColor = "#6366f1";
                }
            }

            if (firstNameInput && lastNameInput) {
                firstNameInput.addEventListener("input", updateInitialsPreview);
                lastNameInput.addEventListener("input", updateInitialsPreview);
            }

            if (photoInput) {
                photoInput.addEventListener("change", function() {
                    if (this.files && this.files[0]) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            avatarPreview.innerHTML = `<img src="${e.target.result}" style="width:100%; height:100%; object-fit:cover; border-radius:50%;" />`;
                        };
                        reader.readAsDataURL(this.files[0]);
                    } else {
                        updateInitialsPreview();
                    }
                });
            }

            function updateTerminationDate() {
                const contractVal = parseInt(contractSelect.value);
                const hireDateVal = hireDateInput.value;

                if (!hireDateVal) return;

                // Permanent (0)
                if (contractVal === 0) {
                    terminationInput.value = "";
                    terminationInput.disabled = true;
                    terminationInput.removeAttribute("required");
                    terminationInput.parentElement.style.opacity = "0.5";
                } else {
                    terminationInput.disabled = false;
                    terminationInput.setAttribute("required", "required");
                    terminationInput.parentElement.style.opacity = "1";
                    terminationInput.min = hireDateVal;

                    // Only set default if not already set by user
                    if (!terminationInput.value) {
                        let hireDate = new Date(hireDateVal);
                        if (isNaN(hireDate.getTime())) return;

                        if (contractVal === 1) { // Temporary
                            hireDate.setFullYear(hireDate.getFullYear() + 1);
                        } else if (contractVal === 2) { // Internship
                            hireDate.setMonth(hireDate.getMonth() + 3);
                        } else if (contractVal === 3) { // Freelance
                            hireDate.setMonth(hireDate.getMonth() + 6);
                        } else if (contractVal === 4) { // NotPermanent
                            hireDate.setMonth(hireDate.getMonth() + 6);
                        }

                        const yyyy = hireDate.getFullYear();
                        let mm = hireDate.getMonth() + 1;
                        let dd = hireDate.getDate();
                        if (mm < 10) mm = '0' + mm;
                        if (dd < 10) dd = '0' + dd;

                        terminationInput.value = `${yyyy}-${mm}-${dd}`;
                    }
                }
            }

            if (contractSelect && hireDateInput && terminationInput) {
                contractSelect.addEventListener("change", function() {
                    // Force recalculate if switching to temporary types
                    if (parseInt(contractSelect.value) !== 0) {
                        terminationInput.value = ""; 
                    }
                    updateTerminationDate();
                });
                hireDateInput.addEventListener("change", function() {
                    terminationInput.value = "";
                    updateTerminationDate();
                });
                updateTerminationDate();
            }
        });
    </script>
}
