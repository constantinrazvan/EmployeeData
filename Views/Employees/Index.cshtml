@model PagedResult<EmployeeData.Models.Person>
@using EmployeeData.Helpers

@{
    ViewData["Title"] = "Employee Directory";
}

<!-- Dashboard Stats Section -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100 p-4 d-flex flex-row align-items-center justify-content-between bg-primary text-white">
            <div>
                <span class="text-white-50 small fw-medium">Total Employees</span>
                <h2 class="fw-bold m-0 mt-1 text-white">@ViewBag.TotalCount</h2>
            </div>
            <div class="p-3 bg-white bg-opacity-25 text-white rounded-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100 p-4 d-flex flex-row align-items-center justify-content-between bg-primary text-white">
            <div>
                <span class="text-white-50 small fw-medium">Active Employees</span>
                <h2 class="fw-bold m-0 mt-1 text-white">@ViewBag.ActiveCount</h2>
            </div>
            <div class="p-3 bg-white bg-opacity-25 text-white rounded-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100 p-4 d-flex flex-row align-items-center justify-content-between bg-primary text-white">
            <div>
                <span class="text-white-50 small fw-medium">Suspended / Inactive</span>
                <h2 class="fw-bold m-0 mt-1 text-white">@ViewBag.InactiveCount</h2>
            </div>
            <div class="p-3 bg-white bg-opacity-25 text-white rounded-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100 p-4 d-flex flex-row align-items-center justify-content-between bg-primary text-white">
            <div>
                <span class="text-white-50 small fw-medium">Departments</span>
                <h2 class="fw-bold m-0 mt-1 text-white">@ViewBag.DepartmentsCount</h2>
            </div>
            <div class="p-3 bg-white bg-opacity-25 text-white rounded-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
            </div>
        </div>
    </div>
</div>

<!-- Header Controls -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Employee records</h3>
        <p class="text-muted small m-0">The complete list of employees in the organization and their management.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="ExportCsv"
           asp-route-searchTerm="@ViewBag.CurrentSearch"
           asp-route-departmentId="@ViewBag.CurrentDept"
           asp-route-status="@ViewBag.CurrentStatus"
           class="btn btn-outline-secondary py-2 px-3 rounded-3 d-flex align-items-center gap-2 fw-semibold">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Export CSV
        </a>
        <a asp-action="Create" class="btn btn-primary py-2 px-4 rounded-3 d-flex align-items-center gap-2 fw-semibold">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add Employee
        </a>
    </div>
</div>

<!-- Search & Filters Panel -->
<div class="card shadow-sm border-0 p-4 mb-4 bg-white text-dark">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label text-muted small fw-medium">Global Search</label>
            <input type="text" name="searchTerm" class="form-control" value="@ViewBag.CurrentSearch" placeholder="Search by name, email, position..." />
        </div>
        <div class="col-md-3">
            <label class="form-label text-muted small fw-medium">Filter Department</label>
            <select name="departmentId" class="form-select" asp-items="ViewBag.Departments">
                <option value="">All Departments</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label text-muted small fw-medium">Status</label>
            <select name="status" class="form-select">
                <option value="">All</option>
                @if (ViewBag.CurrentStatus == "Active")
                {
                    <option value="Active" selected>Active</option>
                    <option value="Inactive">Inactive</option>
                }
                else if (ViewBag.CurrentStatus == "Inactive")
                {
                    <option value="Active">Active</option>
                    <option value="Inactive" selected>Inactive</option>
                }
                else
                {
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary py-2 px-3 rounded-3 flex-fill fw-semibold">
                Search
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary py-2 px-3 rounded-3 d-flex align-items-center justify-content-center" title="Reset Filters">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                </svg>
            </a>
        </div>
    </form>
</div>

<!-- Employees Table -->
<div class="card shadow-sm border-0 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle m-0">
            <thead class="table-light">
                <tr>
                    <th>Full Name</th>
                    <th>Department</th>
                    <th>Position</th>
                    <th>Contact</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-25 mb-3">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="8" y1="12" x2="16" y2="12"></line>
                            </svg>
                            <p class="m-0">No employees found matching the selected filters.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-dark text-decoration-none">
                                    @item.FullName
                                </a>
                                <span class="text-muted small d-block">Hired on: @item.HireDate.ToString("dd.MM.yyyy")</span>
                            </td>
                            <td>
                                <span class="badge bg-secondary font-monospace">@item.Department?.Code</span>
                                <span class="text-muted small d-block d-md-inline ms-md-1">@item.Department?.Name</span>
                            </td>
                            <td>
                                <span class="text-dark fw-medium d-block">@item.Position</span>
                                @{
                                    var badgeClass = item.ContractPeriod switch
                                    {
                                        EmployeeData.Models.Enums.ContractPeriod.Permanent => "bg-success-subtle text-success border border-success-subtle",
                                        EmployeeData.Models.Enums.ContractPeriod.Temporary => "bg-warning-subtle text-warning border border-warning-subtle",
                                        EmployeeData.Models.Enums.ContractPeriod.Internship => "bg-info-subtle text-info border border-info-subtle",
                                        EmployeeData.Models.Enums.ContractPeriod.Freelance => "bg-primary-subtle text-primary border border-primary-subtle",
                                        _ => "bg-secondary-subtle text-secondary border border-secondary-subtle"
                                    };
                                }
                                <span class="badge @badgeClass mt-1" style="font-size: 10px; font-weight: 600; padding: 3px 6px;">@item.ContractPeriod</span>
                                @if (item.TerminationDate.HasValue)
                                {
                                    <span class="text-danger small d-block mt-1" style="font-size: 10.5px; font-weight: 500;">
                                        Ends: @item.TerminationDate.Value.ToString("dd.MM.yyyy")
                                    </span>
                                }
                                else if (item.EstimatedTerminationDate.HasValue)
                                {
                                    <span class="text-warning small d-block mt-1" style="font-size: 10.5px; font-weight: 500;">
                                        Est. End: @item.EstimatedTerminationDate.Value.ToString("dd.MM.yyyy")
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="text-dark d-block small">@item.Email</span>
                                <span class="text-muted small">@item.Phone</span>
                            </td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    <span class="badge bg-success-subtle text-success px-2.5 py-1.5 border border-success-subtle">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 border border-danger-subtle">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm d-flex align-items-center justify-content-center p-2" title="Full Details">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm d-flex align-items-center justify-content-center p-2" title="Edit">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm d-flex align-items-center justify-content-center p-2" title="Delete">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination Section -->
<nav aria-label="Pagination" class="d-flex justify-content-between align-items-center mt-4">
    <div class="small text-muted">
        Showing @Model.StartIndex to @Model.EndIndex of @Model.TotalCount results
    </div>
    <ul class="pagination mb-0">
        @if (Model.HasPreviousPage)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" 
                   asp-route-pageNumber="1"
                   asp-route-searchTerm="@ViewBag.CurrentSearch"
                   asp-route-departmentId="@ViewBag.CurrentDept"
                   asp-route-status="@ViewBag.CurrentStatus"
                   title="First Page">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                        <polyline points="9 18 3 12 9 6"></polyline>
                    </svg>
                </a>
            </li>
            <li class="page-item">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                   asp-route-searchTerm="@ViewBag.CurrentSearch"
                   asp-route-departmentId="@ViewBag.CurrentDept"
                   asp-route-status="@ViewBag.CurrentStatus">
                    Previous
                </a>
            </li>
        }

        @{
            int startPage = Math.Max(1, Model.PageNumber - 2);
            int endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
        }

        @if (startPage > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="1"
                   asp-route-searchTerm="@ViewBag.CurrentSearch"
                   asp-route-departmentId="@ViewBag.CurrentDept"
                   asp-route-status="@ViewBag.CurrentStatus">
                    1
                </a>
            </li>
            @if (startPage > 2)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }
        }

        @for (int i = startPage; i <= endPage; i++)
        {
            @if (i == Model.PageNumber)
            {
                <li class="page-item active"><span class="page-link">@i</span></li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index"
                       asp-route-pageNumber="@i"
                       asp-route-searchTerm="@ViewBag.CurrentSearch"
                       asp-route-departmentId="@ViewBag.CurrentDept"
                       asp-route-status="@ViewBag.CurrentStatus">
                        @i
                    </a>
                </li>
            }
        }

        @if (endPage < Model.TotalPages)
        {
            @if (endPage < Model.TotalPages - 1)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }
            <li class="page-item">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@Model.TotalPages"
                   asp-route-searchTerm="@ViewBag.CurrentSearch"
                   asp-route-departmentId="@ViewBag.CurrentDept"
                   asp-route-status="@ViewBag.CurrentStatus">
                    @Model.TotalPages
                </a>
            </li>
        }

        @if (Model.HasNextPage)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                   asp-route-searchTerm="@ViewBag.CurrentSearch"
                   asp-route-departmentId="@ViewBag.CurrentDept"
                   asp-route-status="@ViewBag.CurrentStatus">
                    Next
                </a>
            </li>
            <li class="page-item">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@Model.TotalPages"
                   asp-route-searchTerm="@ViewBag.CurrentSearch"
                   asp-route-departmentId="@ViewBag.CurrentDept"
                   asp-route-status="@ViewBag.CurrentStatus"
                   title="Last Page">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                        <polyline points="15 18 21 12 15 6"></polyline>
                    </svg>
                </a>
            </li>
        }
    </ul>
</nav>
